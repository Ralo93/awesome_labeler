{"doc_id": "bericht_b5b65554", "page_number": 1, "span_id": "p1_s13", "bbox": [42.52000045776367, 645.411376953125, 525.5609130859375, 658.6179809570312], "text": "Die Daten zeigen anhaltende Herausforderungen wie fragmentierte M\u00e4rkte, \u00fcberm\u00e4\u00dfig komplexe Vorschriften, Sicherheit", "font_size": 9.899999618530273, "bold": false, "italic": false, "line_height": 13.20660400390625, "x_center": 284.0404567718506, "y_bottom": 658.6179809570312, "column": 0, "reading_order": 16, "rotation": 0.0, "language": null, "is_whitespace": false, "char_count": 0, "word_count": 0}
{"doc_id": "bericht_b5b65554", "page_number": 1, "span_id": "p1_s14", "bbox": [42.52000045776367, 660.00830078125, 517.6410522460938, 673.2149047851562], "text": "und strategische Abh\u00e4ngigkeit. Weitere \u00f6ffentliche und private Investitionen und ein leichterer Zugang zu Risikokapital", "font_size": 9.899999618530273, "bold": false, "italic": false, "line_height": 13.20660400390625, "x_center": 280.0805263519287, "y_bottom": 673.2149047851562, "column": 0, "reading_order": 17, "rotation": 0.0, "language": null, "is_whitespace": false, "char_count": 0, "word_count": 0}
